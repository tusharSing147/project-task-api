{
  "name": "project-task-api",
  "version": "1.0.0",
  "description": "Project & Task management API with dual databases (MySQL via Prisma, MongoDB via Mongoose)",
  "main": "index.ts",
  "scripts": {
    "start": "node dist/bin/www.js",
    "dev": "nodemon --exec ts-node --transpile-only --files bin/www.ts",
    "build": "npx prisma generate && tsc",
    "create-db": "prisma db push",
    "prisma-generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@scarf/scarf"
    ]
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-fileupload": "^1.5.2",
    "express-session": "^1.18.2",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "validatorjs": "^3.22.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/body-parser": "^1.19.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/express-fileupload": "^1.5.1",
    "@types/express-session": "^1.18.1",
    "@types/http-errors": "^2.0.5",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.21",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validatorjs": "^3.15.5",
    "nodemon": "^3.1.10",
    "prisma": "^6.19.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
