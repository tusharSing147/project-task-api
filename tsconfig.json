{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "rootDir": "./",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "moduleResolution": "node",
        "resolveJsonModule": true
    },
    "include": [
        "index.ts",
        "bin/**/*.ts",
        "src/**/*.ts",
        "libs/**/*.ts",
        "@types/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
